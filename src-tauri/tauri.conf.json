{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Roses",
	"version": "1.0.3",
	"identifier": "com.montana.roses",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Roses",
				"width": 1920,
				"height": 420,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": true,
				"dragDropEnabled": false
			},
			{
				"label": "settings",
				"title": "Roses Settings",
				"url": "settings.html",
				"width": 620,
				"height": 480,
				"decorations": false,
				"transparent": true,
				"resizable": true,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": false,
				"visibleOnAllWorkspaces": false,
				"focus": true,
				"skipTaskbar": false,
				"shadow": true,
				"visible": false,
				"center": true
			},
			{
				"label": "overlay",
				"title": "Overlay",
				"url": "overlay.html",
				"width": 1920,
				"height": 1080,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false
			},
			{
				"label": "dock",
				"title": "Roses Dock",
				"url": "dock.html",
				"width": 1920,
				"height": 600,
				"x": 0,
				"y": 480,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co https://ip-api.com"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/ddolls/Roses_Windows-11/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCOEZFMjgxMjkxMEFFREMKUldUY3JoQXBnZUtQTzgyUmc5MTFYU2ZwSUJla2dQZ0JkSER6K1BPYVpNQlhrVG9YTlVEYlNmVmMK"
		}
	}
}
